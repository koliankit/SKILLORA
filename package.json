{
  "name": "skillora",
  "version": "0.1.0",
  "private": true,
  "description": "SKILLORA \u2014 AI-powered Entrepreneurship & Enterprise Management Platform",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "api": "cd services/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "build:apk:sh": "bash ./build-apk.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "SKILLORA",
  "license": "UNLICENSED"
}
