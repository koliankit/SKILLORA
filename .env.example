# SKILLORA environment (copy to .env for local development)

# --- Frontend ---------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave EMPTY on a combined Vercel deployment (the app then calls same-origin /api).
# Set it when the API lives elsewhere, e.g. https://skillora-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend ----------------------------------------------------------
ENVIRONMENT=development
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
ENABLE_DEMO_MODE=true

# Optional: public link to the Android build (served by /download-apk)
APK_URL=

# --- Reserved for upcoming features (not read by the code yet) ---------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://skillora:skillora@localhost:5432/skillora
